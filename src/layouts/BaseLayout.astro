---
// Every page is wrapped in this layout: it adds the <head>, the header with
// navigation, and the footer.
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site, url } from '../site';

interface Props {
  /** Shown in the browser tab, before the site name */
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;

// Highlight the nav link for the section we're in.
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const navLinks = [
  { href: '/', label: 'Home', active: path === '/' },
  { href: '/units', label: 'Units', active: path.startsWith('/units') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url('/')}>
          <Logo />
          <span>{site.name}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a href={url(link.href)} aria-current={link.active ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          AP® is a registered trademark of the College Board, which is not affiliated with and does not
          endorse this site. All practice questions are original.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 10;
    padding: 8px 12px;
    background: var(--surface);
    border-radius: var(--radius-sm);
  }

  .skip-link:focus {
    left: 8px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* On very narrow phones the logo already links home, so drop the Home tab. */
  @media (max-width: 370px) {
    nav li:first-child {
      display: none;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 24px 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .site-footer p {
    margin: 0;
  }
</style>
