---
// Every page is wrapped in this layout: it adds the <head>, the header with
// navigation, and the footer.
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site, url } from '../site';

interface Props {
  /** Shown in the browser tab, before the site name */
  title?: string;
  description?: string;
  /** Fit the whole page into one screen with no scrolling (used by the home page) */
  oneScreen?: boolean;
  /** Leave out the site header and footer; the page brings its own (used by practice) */
  bare?: boolean;
}

const { title, description = site.description, oneScreen = false, bare = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;

// Highlight the nav link for the section we're in.
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const navLinks = [{ href: '/units', label: 'Units', active: path.startsWith('/units') }];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      // Apply the saved light/dark choice before the page paints, so it never flashes.
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.mode = 'dark';
      } catch {}
    </script>
  </head>
  <body class:list={[bare ? 'bare' : 'graph-paper', { 'one-screen': oneScreen }]}>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a class="skip-link" href="#main">
            Skip to content
          </a>
          <header class="site-header">
            <div class="container header-inner">
              <a class="brand" href={url('/')}>
                <Logo />
                <span>{site.name}</span>
              </a>
              <div class="header-end">
                <nav aria-label="Main">
                  <ul>
                    {navLinks.map((link) => (
                      <li>
                        <a href={url(link.href)} aria-current={link.active ? 'page' : undefined}>
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
                <ThemeToggle />
              </div>
            </div>
          </header>

          <main id="main">
            <slot />
          </main>

          <footer class="site-footer">
            <div class="container">
              <p>
                AP® is a registered trademark of the College Board, which is not affiliated with and does
                not endorse this site. All practice questions are original.
              </p>
            </div>
          </footer>
        </>
      )
    }
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 10;
    padding: 8px 12px;
    background: var(--surface);
    border-radius: var(--radius-sm);
  }

  .skip-link:focus {
    left: 8px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
  }

  body:not(.one-screen) .site-header {
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.12rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* On the narrowest phones the logo alone stands in for the site name. */
  @media (max-width: 360px) {
    .brand span {
      display: none;
    }
  }

  .site-footer {
    padding: 20px 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  body:not(.one-screen) .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .site-footer p {
    margin: 0;
  }

  /* One-screen pages: header, content, and footer share exactly the window height. */
  .one-screen {
    height: 100vh;
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
  }

  .one-screen main {
    display: flex;
    align-items: center;
    min-height: 0;
  }

  .one-screen .site-footer {
    padding: 12px 0;
  }

  @media (max-width: 900px) {
    .header-inner {
      height: 56px;
    }

    .one-screen main {
      align-items: flex-start;
      padding-top: 8px;
    }
  }

  @media (max-width: 900px) and (max-height: 760px) {
    .one-screen .site-footer {
      padding: 8px 0;
      font-size: 0.7rem;
    }
  }
</style>
