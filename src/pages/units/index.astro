---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeightBar from '../../components/WeightBar.astro';
import { units } from '../../data/units';
import { url } from '../../site';
---

<BaseLayout
  title="All units"
  description="The 8 units of AP Physics 1, with each unit's topics and its share of the multiple-choice section."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">AP Physics 1</p>
      <h1>All 8 units</h1>
      <p class="intro muted">
        Pick a unit to see its topics, practice its questions, and open its cheat sheet. Exam weights
        are for the multiple-choice section and come from the College Board course description.
      </p>

      <ol class="unit-list">
        {
          units.map((unit) => (
            <li>
              <a class="unit-row card" href={url(`/units/${unit.slug}`)}>
                <span class="unit-badge">{unit.number}</span>
                <div class="unit-main">
                  <h2>{unit.title}</h2>
                  <p class="muted">{unit.summary}</p>
                  <ul class="topic-chips" aria-label={`Topics in unit ${unit.number}`}>
                    {unit.topics.map((topic) => (
                      <li>{topic.id} {topic.title}</li>
                    ))}
                  </ul>
                </div>
                <div class="unit-side">
                  <WeightBar weight={unit.examWeight} />
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 44em;
    margin-bottom: 32px;
  }

  .unit-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .unit-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    padding: 20px;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .unit-row:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .unit-main h2 {
    font-size: 1.15rem;
    margin-bottom: 4px;
  }

  .unit-main p {
    margin: 0 0 12px;
    font-size: 0.93rem;
  }

  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topic-chips li {
    padding: 2px 10px;
    border-radius: 99px;
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .unit-side {
    min-width: 230px;
  }

  @media (max-width: 720px) {
    .unit-row {
      grid-template-columns: auto 1fr;
    }

    .unit-side {
      grid-column: 1 / -1;
      min-width: 0;
    }
  }
</style>
