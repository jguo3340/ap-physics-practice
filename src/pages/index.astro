---
// The home page is a single screen: no scrolling and no unit list. Students
// start from the buttons, which lead to the units page.
import BaseLayout from '../layouts/BaseLayout.astro';
import ForceDiagram from '../components/ForceDiagram.astro';
import { units, examFormat } from '../data/units';
import { url } from '../site';

const multipleChoice = examFormat[0];
---

<BaseLayout oneScreen>
  <div class="container hero">
    <div class="hero-text">
      <span class="eyebrow">AP Physics 1 · Multiple choice</span>
      <h1>Practice the part of the exam <em>nobody posts.</em></h1>
      <p class="lede">
        AP-style multiple-choice questions for all {units.length} units, a worked explanation for every
        answer, and a cheat sheet with the key equations and diagrams for each unit.
      </p>
      <div class="actions">
        <a class="button button-primary" href={url('/units')}>Start practicing →</a>
        <a class="button button-secondary" href={url('/units')}>Browse the units</a>
      </div>
      <dl class="facts">
        <div><dt>{units.length}</dt><dd>units</dd></div>
        <div><dt>{multipleChoice.questions}</dt><dd>MCQs on the real exam</dd></div>
        <div><dt>{multipleChoice.minutes} min</dt><dd>for Section I</dd></div>
      </dl>
    </div>
    <ForceDiagram />
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .hero > * {
    min-width: 0;
  }

  h1 {
    font-size: clamp(2.1rem, 5.2vw, 4.1rem);
    line-height: 1.05;
    margin: 0.15em 0 0.35em;
  }

  /* Underlined in red marker, the way you'd stress a word on the board. */
  h1 em {
    font-style: normal;
    color: var(--highlight);
    background-image: linear-gradient(var(--highlight), var(--highlight));
    background-size: 100% 0.08em;
    background-position: 0 92%;
    background-repeat: no-repeat;
  }

  .eyebrow {
    margin-bottom: 0;
  }

  .lede {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    max-width: 32em;
    margin-bottom: 28px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 36px 0 0;
    font-size: 0.95rem;
  }

  .facts dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--force-green);
  }

  .facts dd {
    margin: 0;
  }

  /* Short desktop windows: drop the facts row so everything still fits. */
  @media (min-width: 901px) and (max-height: 700px) {
    .facts {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .facts {
      display: none;
    }

    .lede {
      margin-bottom: 18px;
    }
  }

  @media (max-width: 900px) and (max-height: 760px) {
    .hero {
      gap: 14px;
    }

    h1 {
      font-size: 1.75rem;
      margin: 0.4em 0 0.35em;
    }

    .lede {
      font-size: 0.94rem;
      line-height: 1.5;
      margin-bottom: 14px;
    }

    .button {
      padding: 0.45em 0.85em;
      font-size: 0.95rem;
    }
  }
</style>
