---
import type { Unit } from '../data/units';
import { url } from '../site';
import WeightBar from './WeightBar.astro';

interface Props {
  unit: Unit;
}

const { unit } = Astro.props;
---

<a class="unit-card card" href={url(`/units/${unit.slug}`)}>
  <div class="top">
    <span class="unit-badge">{unit.number}</span>
    <h3>{unit.title}</h3>
  </div>
  <p class="summary muted">{unit.summary}</p>
  <div class="bottom">
    <WeightBar weight={unit.examWeight} />
    <span class="topics">{unit.topics.length} topics</span>
  </div>
</a>

<style>
  .unit-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .unit-card:hover {
    border-color: var(--accent);
    color: var(--text);
    transform: translateY(-2px);
  }

  .top {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  h3 {
    margin: 0;
  }

  .summary {
    flex: 1;
    margin: 0;
    font-size: 0.93rem;
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .topics {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
