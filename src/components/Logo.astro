---
// The site mark: a block with a force arrow, sketched like a simple free-body
// diagram on the board.
---
<svg class="logo" viewBox="0 0 32 32" aria-hidden="true" width="30" height="30">
  <rect x="2" y="2.5" width="28" height="27" rx="7" fill="none" stroke="var(--stroke)" stroke-width="2.2" />
  <rect x="7" y="12" width="10" height="10" rx="1.5" fill="none" stroke="var(--accent)" stroke-width="2.4" />
  <path d="M17 17h8" stroke="var(--highlight)" stroke-width="2.5" stroke-linecap="round" />
  <path
    d="M21.5 13.5 25.5 17l-4 3.5"
    fill="none"
    stroke="var(--highlight)"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
