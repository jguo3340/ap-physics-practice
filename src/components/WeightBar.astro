---
// A small bar showing a unit's share of the multiple-choice section.
// The solid part is the low end of the range, the faded part reaches the high end.
interface Props {
  weight: [number, number];
}

const { weight } = Astro.props;
const [low, high] = weight;
// The biggest unit is 23%, so a 25% scale keeps every bar readable.
const scale = 25;
---

<div class="weight">
  <div class="track" aria-hidden="true">
    <div class="range" style={`width: ${(high / scale) * 100}%`}></div>
    <div class="fill" style={`width: ${(low / scale) * 100}%`}></div>
  </div>
  <span class="label">{low}–{high}% of the exam</span>
</div>

<style>
  .weight {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .track {
    position: relative;
    flex: none;
    width: 112px;
    height: 8px;
    border-radius: 99px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .range,
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 99px;
  }

  .range {
    background: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .fill {
    background: var(--accent);
  }

  .label {
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
</style>
