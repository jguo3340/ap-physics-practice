---
// Sun/moon switch in the header. The choice is remembered in the browser, and
// a small script in BaseLayout applies it before the page paints.
---

<button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
  <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  // The attribute is data-mode rather than data-theme so pages embedded in other
  // apps can't have their theme overridden by the host.
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

  function savedMode() {
    try {
      return localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
    } catch {
      return root.dataset.mode === 'dark' ? 'dark' : 'light';
    }
  }

  function apply(mode: 'dark' | 'light') {
    root.dataset.mode = mode;
    for (const button of buttons) button.setAttribute('aria-pressed', String(mode === 'dark'));
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const mode = root.dataset.mode === 'dark' ? 'light' : 'dark';
      apply(mode);
      try {
        localStorage.setItem('theme', mode);
      } catch {
        // Private windows can block storage; the switch still works for this visit.
      }
    });
  }

  apply(savedMode());
  // The back button can restore a page exactly as it was left, so re-read the
  // saved choice whenever a page is shown again.
  window.addEventListener('pageshow', () => apply(savedMode()));
</script>

<style>
  .theme-toggle {
    position: relative;
    flex: none;
    width: 52px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-2);
    cursor: pointer;
  }

  .theme-toggle::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--text);
    transition: transform 0.2s;
  }

  .theme-toggle[aria-pressed='true']::after {
    transform: translateX(24px);
  }

  svg {
    position: absolute;
    top: 6px;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .moon {
    left: 7px;
  }

  .sun {
    right: 7px;
  }
</style>
